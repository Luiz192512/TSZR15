{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsz-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  // URLs de preview por versao (wrangler versions upload) para revisar
  // mudancas sem afetar o trafego de producao.
  "preview_urls": true,
  // Alvo declarado no proprio config para que producao nunca dependa de um
  // default implicito. O guard em src/lib/environment-guard.js derruba o boot
  // se este alvo nao bater com as credenciais presentes no Worker.
  "vars": {
    "SUPABASE_RUNTIME_TARGET": "production"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "a12d6d53e59948a888bc62e5a30de08e"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "a12d6d53e59948a888bc62e5a30de08e"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tsz-store"
    }
  ],
  "observability": {
    "enabled": true
  }
}
