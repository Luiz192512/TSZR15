NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=5511999999999
WHATSAPP_BUSINESS_NUMBER=5511999999999
NEXT_PUBLIC_STORE_NAME=TSZR15
NEXT_PUBLIC_SITE_URL=https://www.tszr15-store.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Fallbacks used when a hosted integration provides server-side names only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Alvo do ambiente: "production" (padrao quando ausente) ou "preview".
# Em desenvolvimento local, .env.development.local fixa "preview" para que
# `npm run dev` nunca cobre de verdade nem escreva no banco da loja no ar.
# Declarado em vars nos dois wrangler*.jsonc; ver docs/AMBIENTES.md.
# Em preview o app usa SOMENTE as chaves SUPABASE_PREVIEW_*, sem cair em producao.
SUPABASE_RUNTIME_TARGET=
NEXT_PUBLIC_SUPABASE_PREVIEW_URL=
NEXT_PUBLIC_SUPABASE_PREVIEW_PUBLISHABLE_KEY=
SUPABASE_PREVIEW_URL=
SUPABASE_PREVIEW_PUBLISHABLE_KEY=
SUPABASE_PREVIEW_ANON_KEY=
SUPABASE_PREVIEW_SERVICE_ROLE_KEY=
SUPABASE_PREVIEW_SECRET_KEY=
# Token do painel admin em PRODUCAO. Entrar em /entrar com usuario "admin".
TSZR15_ADMIN_TOKEN=
# Token do painel admin no STAGING. Sem fallback: o staging que nao tiver o
# proprio token fica com o admin desligado, nunca cai no de producao. Precisa
# ser diferente — o guard de ambiente recusa subir se os dois forem iguais.
TSZR15_PREVIEW_ADMIN_TOKEN=

# --- Mercado Pago ---
# O painel separa TESTE e PRODUCAO em tudo: credenciais e webhook, cada um com
# seu segredo. O NOME da variavel declara o ambiente; nao ha fallback entre os
# dois conjuntos, mesma regra dos dois projetos Supabase.
#
# Cada aba do painel tem DOIS campos, e eles nao sao intercambiaveis:
#   Public Key   = PREFIXO + UUID (41 chars). Vai para o navegador tokenizar cartao.
#   Access Token = bem mais longo, com segmentos numericos. Fica so no servidor.
# Conferir depois de preencher: npm run pagamento:verificar

# Staging (SUPABASE_RUNTIME_TARGET=preview) le SOMENTE estas:
NEXT_PUBLIC_MERCADOPAGO_SANDBOX_PUBLIC_KEY=
MERCADOPAGO_SANDBOX_ACCESS_TOKEN=

# Producao le SOMENTE estas:
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Segredo de assinatura do webhook. Nao ha par sandbox/producao: o painel do
# provedor tem UM webhook so, entao esta chave vale para os dois ambientes.
MERCADOPAGO_WEBHOOK_SECRET=

# Chave de habilitacao, por ambiente e sem fallback: ausente ou 'false' mantem
# so o fluxo de WhatsApp. Producao sobe DESLIGADA e liga depois de validada em
# staging, sem novo deploy. Ligar o staging nao liga a loja no ar.
PAYMENTS_ONLINE_ENABLED=
PAYMENTS_PREVIEW_ONLINE_ENABLED=
