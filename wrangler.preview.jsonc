{
  // Worker de STAGING para revisar branches sem tocar na producao.
  // Deploy: npx wrangler deploy --config wrangler.preview.jsonc
  // URL: https://tsz-store-preview.enz-luizgustavo.workers.dev
  // Namespaces KV, Durable Object e self-reference sao proprios: o staging nao
  // compartilha nada de cache com a producao. Antes os dois usavam o mesmo KV,
  // e uma revalidacao disparada aqui podia invalidar tags da loja no ar.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsz-store-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Sem esta variavel o Worker de preview resolvia para o Supabase de PRODUCAO:
  // o codigo antigo caia em VERCEL_ENV, que nao existe na Cloudflare.
  "vars": {
    "SUPABASE_RUNTIME_TARGET": "preview"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "f9f7d157244e43d68409007089560f3b"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "e12569429ae240a08c6f3caf48f63ec9"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tsz-store-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
