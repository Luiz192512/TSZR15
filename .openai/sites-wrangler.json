{
  "name": "tszr15-sites-preview",
  "main": "index.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "../assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
